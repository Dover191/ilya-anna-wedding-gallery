# Timeweb S3 endpoint is specified without http:// or https://.
MINIO_ENDPOINT=s3.twcstorage.ru
MINIO_ACCESS_KEY=replace-with-timeweb-access-key
MINIO_SECRET_KEY=replace-with-timeweb-secret-key
MINIO_BUCKET=ilya-anna-wedding
MINIO_USE_SSL=true
MINIO_REGION=ru-1
MINIO_PREFIX=guest-media/2026-09-06

PORT=3000
PRESIGNED_PUT_TTL=15m
PRESIGNED_GET_TTL=1h
MAX_FILE_SIZE=314572800
